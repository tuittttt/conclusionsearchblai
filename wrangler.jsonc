{
  "name": "conclusionsearchblai",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conclusionsearchblai",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0 4,10,16,22 * * *"
    ]
  },
  "keep_vars": true
}
